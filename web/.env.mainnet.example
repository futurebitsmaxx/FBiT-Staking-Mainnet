# ===== FBiT Staking — Mainnet Environment =====
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# ===== AI BOT MANAGEMENT (server-side only — never exposed to browser) =====
# Required for /api/bot-assess — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ===== SITE URL (used for /api/bot-assess and /api/support-chat origin validation) =====
# Your production domain — comma-separated if multiple
NEXT_PUBLIC_SITE_URL=https://stake-futurebit.vercel.app

# ===== ADMIN ACCESS =====
# Comma-separated SHA-256 hex digests of the admin wallet address(es) (base58, case-sensitive
# before hashing). Stored as hashes, not raw addresses, so the admin wallet can't be read
# directly out of the public JS bundle. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_ADDRESS').digest('hex'))"
NEXT_PUBLIC_ADMIN_ADDRESS_HASHES=<YOUR_ADMIN_ADDRESS_SHA256_HASH>

# ===== REOWN (WalletConnect) =====
# Get your project IDs from https://cloud.reown.com
# PRIMARY_ID is used first; FALLBACK_ID is tried if primary fails to init.
NEXT_PUBLIC_REOWN_PROJECT_ID=<YOUR_REOWN_PROJECT_ID>
NEXT_PUBLIC_REOWN_PROJECT_ID_2=<YOUR_REOWN_PROJECT_ID_FALLBACK>

# ===== SOLANA MAINNET =====
# Helius RPC (recommended) — get a free key at https://dev.helius.xyz
# When set, ALL Solana RPC calls use Helius (fastest + most reliable).
NEXT_PUBLIC_HELIUS_API_KEY=<YOUR_HELIUS_API_KEY>
# Fallback RPC used only when HELIUS_API_KEY is blank.
# api.mainnet-beta.solana.com is reliable; publicnode 504s on some methods.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Deploy the Anchor program → paste Program ID here
NEXT_PUBLIC_SOLANA_PROGRAM_ID=<YOUR_DEPLOYED_PROGRAM_ID>
# FBiT SPL Token Mint (9 decimals, 250,000,000 fixed supply, mint authority renounced)
NEXT_PUBLIC_SOLANA_STAKE_TOKEN_MINT=5uJ8rkiqEs5uzERCqVw9a1eC6BkP54MZAF3D229dyoME
NEXT_PUBLIC_SOLANA_REWARD_TOKEN_MINT=5uJ8rkiqEs5uzERCqVw9a1eC6BkP54MZAF3D229dyoME
# Vault token accounts (owned by Platform PDA).
# Leave blank to auto-derive as ATA(mint, platformPDA) — works for standard single-vault setup.
NEXT_PUBLIC_SOLANA_STAKE_VAULT=
NEXT_PUBLIC_SOLANA_REWARD_VAULT=
NEXT_PUBLIC_SOLANA_RESERVE_VAULT=
